{#
  Site footer — ported from DIWEBA/DIWEBA Website.dc.html.

  footerNote prints ONLY confirmed facts. The design's own footer note reads
  "DIWEBA · [ADRESSE] · [TELEFON]" — address and phone are unresolved
  (src/_data/company.js), so this renders the brand and legal name only until
  those exist. No bracket placeholder text is ever output; see company.js for
  why these are null rather than filled with something plausible.

  The address is shown only when `publishAddressPublicly` is true — see
  company.js and spec §12 for why that is a separate decision from the
  Impressum's legal requirement to state it somewhere on the site.
#}
{%- set t = ui[lang] -%}
{%- set otherLang = "en" if lang == "de" else "de" -%}

<footer class="site-footer">
  <div class="site-footer__col">
    <div class="site-footer__brand">
      <span class="site-header__logo">{% include "partials/logo-mark.njk" %}</span>
      <span class="site-footer__brand-name">{{ company.brand }}</span>
    </div>
    <p class="site-footer__note">
      {{ company.brand }} · {{ company.legalName }}
      {%- if company.publishAddressPublicly %} · {{ company.address.street }}, {{ company.address.postalCode }} {{ company.address.city }}{% endif -%}
      {%- if company.phone %} · {{ company.phone }}{% endif -%}
    </p>
  </div>

  <nav class="site-footer__col" aria-label="{{ t.footerNavAria }}">
    {%- for key, entry in routes %}
      {%- if entry.nav %}
    <a class="site-footer__link" href="{{ key | route(lang) }}">{{ t.nav[key] }}</a>
      {%- endif %}
    {%- endfor %}
  </nav>

  <nav class="site-footer__col" aria-label="{{ t.footerNavAria }}">
    {%- for key, entry in routes %}
      {%- if entry.legal %}
    <a class="site-footer__link" href="{{ key | route(lang) }}">{{ t.legal[key] }}</a>
      {%- endif %}
    {%- endfor %}
    <div class="site-footer__langs">
      <a href="{{ routes[routeKey][lang] }}" aria-current="true">{{ lang | upper }}</a>
      <span class="site-footer__langs-divider" aria-hidden="true"></span>
      <a href="{{ routes[routeKey][otherLang] }}" hreflang="{{ otherLang }}" lang="{{ otherLang }}">{{ otherLang | upper }}</a>
    </div>
  </nav>
</footer>
