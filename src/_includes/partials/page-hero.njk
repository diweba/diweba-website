{#
  Shared page-header pattern for non-home pages: eyebrow + H1 + intro, in a
  bordered block. Ported from the design's isPricing/isProcess markup, which
  uses this exact structure identically on every secondary page.

  Params (set by the including template before {% include %}):
    heroEyebrow  small mono label above the H1
    heroH1       the page's real H1 text
    heroSub      optional intro paragraph
#}
<div class="row row--edge-bottom" style="padding-block:clamp(2rem, 4.4vw, 4rem) clamp(1.5rem, 3vw, 2.5rem)">
  <div class="container stack" style="gap:14px">
    <p class="eyebrow" style="color:var(--color-accent-amber-strong)">{{ heroEyebrow }}</p>
    <h1 style="font-size:clamp(2rem, 3.8vw, 3.25rem)">{{ heroH1 }}</h1>
    {%- if heroSub %}
    <p class="text-soft" style="font-size:var(--text-md);line-height:var(--leading-relaxed);max-width:40em">{{ heroSub }}</p>
    {%- endif %}
  </div>
</div>
