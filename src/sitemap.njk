---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
{#
  XML sitemap — canonical, indexable URLs only.

  Driven by the route registry, so it cannot drift from the pages that actually
  exist. Excluded automatically:
    - routes flagged noindex (thank-you pages)
    - routes with no page actually built yet (routes.js can carry a route
      before its page exists -- Phase 3E's service/smallBusiness entries are
      exactly this; `key in collections.routeKeys` is what makes "cannot
      drift from the pages that actually exist" true rather than aspirational
      -- Phase 4's audit found this template advertising two 404s until this
      check was added)
    - /admin/ (not in the registry at all)
    - 404
  Each entry carries its xhtml:link alternates, which is the sitemap-level
  counterpart to the on-page hreflang cluster.

  Emitted only for production builds; a preview sitemap would invite indexing.
#}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- if site.indexable -%}
{%- for key, entry in routes %}
{%- if not entry.noindex and key in collections.routeKeys %}
{%- for lang in site.languages %}
  <url>
    <loc>{{ entry[lang] | absolute(site.url) }}</loc>
    <xhtml:link rel="alternate" hreflang="de" href="{{ entry.de | absolute(site.url) }}"/>
    <xhtml:link rel="alternate" hreflang="en" href="{{ entry.en | absolute(site.url) }}"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ entry.de | absolute(site.url) }}"/>
  </url>
{%- endfor %}
{%- endif %}
{%- endfor %}
{%- endif %}
</urlset>
