# DIWEBA — environment variable template
#
# Copy to `.env` and fill in. `.env` is gitignored and must NEVER be committed.
# This file contains VARIABLE NAMES ONLY — never paste real values here.
#
# Two different kinds of value live in this project:
#
#   BUILD-TIME CONFIG  — read by Eleventy, ends up in the generated HTML.
#                        Public by design (anyone can read them in page source).
#                        Set in `.env` locally and as GitHub Actions variables in CI.
#
#   WORKER SECRETS     — read by the Cloudflare Worker at runtime, never sent to
#                        the browser. Set with `wrangler secret put <NAME>`.
#                        For local Worker dev, put them in `.dev.vars` (gitignored).
#
# =============================================================================
# BUILD-TIME CONFIG (public — appears in HTML)
# =============================================================================

# Canonical origin. No trailing slash.
# Production: https://diweba.de
SITE_URL=

# Deployment context. One of: development | preview | production
# Anything other than "production" forces noindex site-wide and disables analytics.
SITE_ENV=development

# --- Analytics & consent -----------------------------------------------------
# NOT YET CONFIGURED. Leave every one of these EMPTY until the owner supplies them.
#
# Behaviour when empty: the consent/analytics block renders nothing at all — no
# Consent Mode defaults, no Usercentrics loader, no GTM snippet. The site is
# fully functional without them. Nothing is faked or stubbed.
#
# Behaviour when filled: `src/_includes/partials/consent-head.njk` emits the four
# blocks in the exact order required by the spec (charset → Consent Mode v2
# defaults → Usercentrics → GTM). See that file's header comment.
#
# INTEGRATION POINT — this is the only place these IDs are ever entered.

# Usercentrics settings ID (from the Usercentrics admin interface)
USERCENTRICS_SETTINGS_ID=

# Google Tag Manager container ID, format GTM-XXXXXXX
GTM_CONTAINER_ID=

# GA4 measurement ID, format G-XXXXXXXXXX
# Configured inside GTM. Recorded here only so the privacy policy and the
# verification tooling can reference the exact property in use.
GA4_MEASUREMENT_ID=

# --- Turnstile ---------------------------------------------------------------
# Public site key, rendered into the contact form widget.
TURNSTILE_SITE_KEY=

# =============================================================================
# WORKER SECRETS (private — never reaches the browser)
# =============================================================================
# Production: set with `wrangler secret put <NAME>` — do NOT put values in
# wrangler.jsonc. Local Worker development: create `.dev.vars` (gitignored).

# Turnstile secret key — server-side token verification.
TURNSTILE_SECRET_KEY=

# Brevo transactional email API key.
BREVO_API_KEY=

# Verified Brevo sender. The domain must have SPF, DKIM and DMARC configured
# on diweba.de before sending will work reliably.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=DIWEBA

# Where contact-form notifications are delivered.
# BLOCKED: DIWEBA has no confirmed contact address yet. See docs/DIWEBA_PHASE_0_SPEC.md §1.
CONTACT_NOTIFY_EMAIL=

# =============================================================================
# CI / DEPLOYMENT (GitHub Actions repository secrets — never in .env)
# =============================================================================
# CLOUDFLARE_API_TOKEN    — scoped to Workers deploy + zone settings write
# CLOUDFLARE_ACCOUNT_ID   — Cloudflare account identifier
