{
  "name": "diweba-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DIWEBA — fixed-price, fixed-scope websites for German and European SMBs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "cross-env ELEVENTY_ENV=development eleventy --serve --quiet",
    "build": "cross-env ELEVENTY_ENV=production eleventy",
    "clean": "node tools/clean.mjs",
    "verify": "node tools/verify-build.mjs && node tools/verify-i18n.mjs",
    "check": "npm run build && npm run verify",
    "worker:types": "tsc --noEmit -p tsconfig.json",
    "worker:dev": "wrangler dev",
    "deploy": "npm run check && wrangler deploy"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@cloudflare/workers-types": "^4.20250109.0",
    "cross-env": "^7.0.3",
    "typescript": "^5.7.0",
    "wrangler": "^3.99.0"
  }
}
